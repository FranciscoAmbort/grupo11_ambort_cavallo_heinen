# Copiar a .env y completar. El archivo .env nunca se versiona.

# Credenciales del contenedor PostgreSQL (las usa docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# Solo para correr la app fuera de Docker; dentro de Compose se arma sola
# apuntando al servicio "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/monitor

# Clave para firmar los JWT de sesion (generar una con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
# Client ID de Google OAuth (opcional; si se define, se valida el aud del id_token)
GOOGLE_CLIENT_ID=
# Atributo Secure de la cookie de sesion: false para http://localhost, true en produccion (HTTPS)
COOKIE_SECURE=false

# Token del bot de Telegram para las alertas push. Opcional: si queda vacio no se envian mensajes.
TELEGRAM_BOT_TOKEN=

# Correo de respaldo para alertas (API de Brevo). Opcional: si quedan vacios no se envian correos.
BREVO_API_KEY=
# Direccion remitente verificada en Brevo
EMAIL_FROM=

# Resumen semanal con IA (Gemini). Opcional: sin clave se muestran solo las estadisticas.
GEMINI_API_KEY=
# Modelo de Gemini; vacio usa gemini-3.5-flash-lite
GEMINI_MODEL=

# Segundos entre ciclos del worker de monitoreo
WORKER_INTERVAL_SECONDS=60

# Ancho de vela intradiaria de Yahoo Finance; vacio usa 1m
YAHOO_INTERVAL=
# Minutos de ventana de gracia post-cierre para Yahoo Finance (0 la desactiva)
YAHOO_POST_CLOSE_MINUTES=15

