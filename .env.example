# Copiar a .env y completar. El archivo .env nunca se versiona.

# Credenciales del contenedor PostgreSQL (las usa docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=monitor

# Solo para correr la app fuera de Docker; dentro de Compose se arma sola
# apuntando al servicio "db".
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/monitor

# Clave para firmar los JWT de sesi�n (generar con: python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=OL_6hbTV8pw3LvN1Iya2SfAhGOGG0SUdJvaJQLAUERaEpiIXW4nj7WlaVawFwCGy
# Client ID de Google OAuth (opcional; si se define, se valida el aud del id_token)
GOOGLE_CLIENT_ID=

# Correo de respaldo para alertas (API de Brevo). Opcional: si quedan vacios no se envian correos.
BREVO_API_KEY=
# Direccion remitente verificada en Brevo
EMAIL_FROM=

# Resumen semanal con IA (Gemini). Opcional: sin clave se muestran solo las estadisticas.
GEMINI_API_KEY=
# Modelo de Gemini; vacio usa gemini-3.5-flash-lite
GEMINI_MODEL=
